# ─── NewnopDesk AI service ───────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Shared secret the Node backend sends as "Authorization: Bearer <token>".
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=

# LLM provider: "gemini" (real model) or "fake" (deterministic, no API key,
# for local development without a key)
AI_PROVIDER=gemini

# Google AI Studio API key (required when AI_PROVIDER=gemini).
# Free-tier keys: Google may use prompts and responses to improve its
# products. Use a paid tier for real client data.
GEMINI_API_KEY=

# Model ID. Flash-Lite is the cheapest current option and is free-tier eligible.
AI_MODEL=gemini-3.5-flash-lite

# Thinking depth for Gemini 3 models: minimal, low, medium or high.
# Classification needs little reasoning; minimal keeps latency and cost down.
LLM_THINKING_LEVEL=minimal

# Leave unset to use the model's default temperature.
# LLM_TEMPERATURE=

# Hard time limit for one LLM call, in seconds. The service never retries;
# the Node backend's job queue decides whether to retry.
LLM_TIMEOUT_SECONDS=20

# Client text longer than this is truncated before it is sent to the model.
MAX_INPUT_CHARS=8000

LOG_LEVEL=INFO

# Serve interactive API docs at /docs. Keep off in production.
AI_SERVICE_DOCS=false
