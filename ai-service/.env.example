# ─── NewnopDesk AI service ───────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# Shared secret the Node backend sends as "Authorization: Bearer <token>".
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=

# LLM provider: "gemini" (real model) or "fake" (deterministic, no API key,
# for local development without a key)
AI_PROVIDER=gemini

# Google AI Studio API key (required when AI_PROVIDER=gemini).
# Free-tier keys: Google may use prompts and responses to improve its
# products. Use a paid tier for real client data.
GEMINI_API_KEY=

# Model ID. Flash-Lite is the cheapest current option and is free-tier eligible.
AI_MODEL=gemini-3.5-flash-lite

# Thinking depth for Gemini 3 models: minimal, low, medium or high.
# Classification needs little reasoning; minimal keeps latency and cost down.
LLM_THINKING_LEVEL=minimal

# Leave unset to use the model's default temperature.
# LLM_TEMPERATURE=

# Hard time limit for one LLM call, in seconds. The service never retries;
# the Node backend's job queue decides whether to retry.
LLM_TIMEOUT_SECONDS=20

# Client text longer than this is truncated before it is sent to the model.
MAX_INPUT_CHARS=8000

LOG_LEVEL=INFO

# Serve interactive API docs at /docs. Keep off in production.
AI_SERVICE_DOCS=false

# ─── Retrieval: similar issues and suggested resolutions ─────────────────────
# Connection as the restricted ai_service database role. Leave empty to turn
# retrieval off (triage and sentiment still work). Use 127.0.0.1, not
# localhost: the PostgreSQL client tries IPv6 first, which can stall when
# Docker only listens on IPv4.
#
# One-time setup (as a database administrator), then apply migrations:
#   uv run ai-db bootstrap --admin-url postgresql://ADMIN:PASSWORD@127.0.0.1:5432/newnopdesk
#   uv run ai-db migrate
AI_DATABASE_URL=postgresql://ai_service:ai_service_local@127.0.0.1:5432/newnopdesk

# fastembed runs a local ONNX model (no API key). "fake" is for tests only.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where to keep the downloaded model (~67 MB). Empty = fastembed's temp folder.
# EMBEDDING_CACHE_DIR=

# Cosine similarity a past issue needs to count as similar, and how many to use
RETRIEVAL_MIN_SIMILARITY=0.70
RETRIEVAL_MAX_RESULTS=5
