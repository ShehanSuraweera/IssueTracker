# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The value below matches the local database in docker-compose.yml. Start it
# from the repo root with: docker compose up -d db
#
# Production (Amazon RDS) requires verified TLS. Append, for example:
#   ?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
# See docs/deployment.md, section 5.
DATABASE_URL="postgresql://newnopdesk:newnopdesk_local@localhost:5432/newnopdesk"

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate keys first: npx tsx scripts/generate-keys.ts
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Token TTLs
ACCESS_TOKEN_TTL_SECONDS=900     # 15 minutes
REFRESH_TOKEN_TTL_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Seed (prisma/seed.ts) ────────────────────────────────────────────────────
# All demo users (engineers, clients, second admin) use SEED_DEMO_PASSWORD.
# SEED_ADMIN_PASSWORD defaults to SEED_DEMO_PASSWORD if not set.
SEED_ADMIN_EMAIL=admin@newnop.com
SEED_ADMIN_PASSWORD=ChangeMe@Prod1
SEED_DEMO_PASSWORD=Demo@2026

AWS_REGION=ap-northeast-2
AWS_BUCKET_ATTACHMENTS=newnopdesk-attachments
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMTP (Phase 2 — Email Notifications) ─────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-sending-account@gmail.com
# SMTP_PASSWORD=your-app-password        # Google App Password, NOT your login password
# SMTP_FROM="NewnopDesk <no-reply@newnop.com>"

# ─── AI layer ─────────────────────────────────────────────────────────────────
# Master switch for every AI feature. When false (the default), the app behaves
# exactly as it did before the AI layer existed. Accepts true/false.
AI_ENABLED=false

# Internal URL of the Python AI service (ai-service/). Never exposed publicly.
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret; must equal AI_SERVICE_TOKEN in ai-service/.env. At least 32
# characters, and required when AI_ENABLED=true. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
AI_SERVICE_TOKEN=

# Time limit for one call to the AI service, in milliseconds
AI_TIMEOUT_MS=25000

# The background worker that sends queued jobs to the AI service. Set false on
# a server that should only serve HTTP while another process runs the worker.
AI_WORKER_ENABLED=true
AI_WORKER_POLL_MS=3000

# Attempts per AI job before it is marked failed (retries use exponential backoff)
AI_JOB_MAX_ATTEMPTS=5
