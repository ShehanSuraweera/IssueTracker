# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/newnopdesk"

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Generate keys first: npx tsx scripts/generate-keys.ts
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Token TTLs
ACCESS_TOKEN_TTL_SECONDS=900     # 15 minutes
REFRESH_TOKEN_TTL_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Seed (prisma/seed.ts) ────────────────────────────────────────────────────
# All demo users (engineers, clients, second admin) use SEED_DEMO_PASSWORD.
# SEED_ADMIN_PASSWORD defaults to SEED_DEMO_PASSWORD if not set.
SEED_ADMIN_EMAIL=admin@newnop.com
SEED_ADMIN_PASSWORD=ChangeMe@Prod1
SEED_DEMO_PASSWORD=Demo@2026

AWS_REGION=ap-northeast-2
AWS_BUCKET_ATTACHMENTS=newnopdesk-attachments
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMTP (Phase 2 — Email Notifications) ─────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-sending-account@gmail.com
# SMTP_PASSWORD=your-app-password        # Google App Password, NOT your login password
# SMTP_FROM="NewnopDesk <no-reply@newnop.com>"



