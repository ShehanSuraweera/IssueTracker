generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Region {
  KR
  LK
  IN
  GLOBAL
}

enum Office {
  KR
  LK
  IN
}

enum UserRole {
  client_user
  engineer
  admin
}

enum IssueStatus {
  new
  in_progress
  on_hold
  resolved
  closed
  cancelled
}

enum IssueType {
  bug
  feature_request
  question
  incident
}

enum ImpactLevel {
  low
  medium
  high
}

enum UrgencyLevel {
  low
  medium
  high
}

enum PriorityLevel {
  low
  moderate
  high
  critical
}

// Functional area of an issue. Must match ai-service/src/ai_service/taxonomy.py
enum IssueCategory {
  authentication_access
  notifications
  data_integrity
  performance
  ui_display
  crash_error
  file_handling
  integrations
  reporting_analytics
  other
}

// Engineering team that owns the fix. Must match ai-service taxonomy.py
enum EngineeringTeam {
  mobile
  web_frontend
  backend
  data_platform
  infrastructure
  support
}

// ─── AI enums ────────────────────────────────────────────────────────────────

enum AiJobKind {
  analyze_issue
  sentiment_comment
  // Sync a resolved issue into (or out of) the similarity index
  index_issue
}

enum AiJobStatus {
  queued
  running
  done
  failed
}

enum AiSuggestionStatus {
  pending
  accepted   // applied exactly as suggested
  edited     // applied with at least one value changed by the reviewer
  rejected   // discarded
  superseded // replaced by a newer suggestion before anyone reviewed it
}

enum Sentiment {
  negative
  neutral
  positive
}

enum RiskLevel {
  low
  medium
  high
}

enum ConfidenceLevel {
  low
  medium
  high
}

enum ResolutionFeedback {
  helpful
  not_helpful
}

// ─── Core Tables ────────────────────────────────────────────────────────────

model Company {
  id           BigInt    @id @default(autoincrement())
  name         String    @db.VarChar(120)
  contactEmail String    @db.VarChar(255) @map("contact_email")
  region       Region
  createdAt    DateTime  @default(now()) @map("created_at")

  products Products[]
  users    User[]

  @@index([region], name: "idx_companies_region")
  @@map("companies")
}

model Products {
  id           BigInt   @id @default(autoincrement())
  companyId    BigInt   @map("company_id")
  name         String   @db.VarChar(120)
  code         String   @unique @db.VarChar(8)
  owningOffice Office   @map("owning_office")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  company           Company             @relation(fields: [companyId], references: [id])
  issues            Issue[]
  userProductAccess UserProductAccess[]

  @@index([companyId], name: "idx_products_company")
  @@index([owningOffice], name: "idx_products_office")
  @@map("products")
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255) @map("password_hash")
  fullName     String   @db.VarChar(120) @map("full_name")
  role         UserRole
  companyId    BigInt?  @map("company_id")
  office       Office?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  company           Company?            @relation(fields: [companyId], references: [id])
  createdIssues     Issue[]             @relation("IssueCreatedBy")
  assignedIssues    Issue[]             @relation("IssueAssignedTo")
  comments          IssueComment[]
  activityLogs      IssueActivity[]
  attachments       IssueAttachment[]
  userProductAccess UserProductAccess[]
  refreshTokens     RefreshToken[]
  savedViews        SavedView[]
  aiReviews         AiSuggestion[]      @relation("AiSuggestionReviewer")

  @@index([role], name: "idx_users_role")
  @@index([companyId], name: "idx_users_company")
  @@map("users")
}

model SavedView {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  name      String   @db.VarChar(120)
  query     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_saved_views_user")
  @@map("saved_views")
}

model UserProductAccess {
  userId    BigInt   @map("user_id")
  productId BigInt   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  product Products @relation(fields: [productId], references: [id])

  @@id([userId, productId])
  @@index([productId], name: "idx_upa_product")
  @@map("user_product_access")
}

model Issue {
  id           BigInt        @id @default(autoincrement())
  ticketNumber String        @unique @db.VarChar(16) @map("ticket_number")
  productId    BigInt        @map("product_id")
  title        String        @db.VarChar(200)
  description  String        @db.Text
  status       IssueStatus   @default(new)
  type         IssueType
  impact       ImpactLevel   @default(medium)
  urgency      UrgencyLevel  @default(medium)
  priority     PriorityLevel
  // Set by staff, typically by accepting or editing an AI triage suggestion
  category     IssueCategory?
  team         EngineeringTeam?
  createdBy    BigInt        @map("created_by")
  assignedTo   BigInt?       @map("assigned_to")
  slaDeadline  DateTime?     @map("sla_due_at")
  resolvedAt   DateTime?     @map("resolved_at")
  closedAt     DateTime?     @map("closed_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  product     Products          @relation(fields: [productId], references: [id])
  creator     User              @relation("IssueCreatedBy", fields: [createdBy], references: [id])
  assignee    User?             @relation("IssueAssignedTo", fields: [assignedTo], references: [id])
  comments    IssueComment[]
  activities  IssueActivity[]
  attachments IssueAttachment[]
  aiJobs        AiJob[]
  aiSuggestions AiSuggestion[]
  aiSentiments  AiSentiment[]
  aiResolutions AiResolutionSuggestion[]
  aiSummaries   AiThreadSummary[]

  @@index([productId, status], name: "idx_issues_product_status")
  @@index([assignedTo], name: "idx_issues_assigned")
  @@index([createdBy], name: "idx_issues_created_by")
  @@map("issues")
}

model IssueComment {
  id         BigInt   @id @default(autoincrement())
  issueId    BigInt   @map("issue_id")
  userId     BigInt   @map("user_id")
  body       String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  aiJobs       AiJob[]
  aiSentiments AiSentiment[]

  @@index([issueId, createdAt], name: "idx_comments_issue")
  @@map("issue_comments")
}

model IssueActivity {
  id        BigInt   @id @default(autoincrement())
  issueId   BigInt   @map("issue_id")
  userId    BigInt   @map("user_id")
  fieldName String   @db.VarChar(64) @map("field_name")
  oldValue  String?  @db.VarChar(255) @map("old_value")
  newValue  String?  @db.VarChar(255) @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([issueId, createdAt], name: "idx_activity_issue")
  @@map("issue_activity")
}

model IssueAttachment {
  id         BigInt   @id @default(autoincrement())
  issueId    BigInt   @map("issue_id")
  s3Key      String   @db.VarChar(512) @map("s3_key")
  filename   String   @db.VarChar(255)
  sizeBytes  BigInt   @map("size_bytes")
  mimeType   String   @db.VarChar(127) @map("mime_type")
  uploadedBy BigInt   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  issue    Issue @relation(fields: [issueId], references: [id])
  uploader User  @relation(fields: [uploadedBy], references: [id])

  @@index([issueId], name: "idx_attachments_issue")
  @@map("issue_attachments")
}

// ─── Auth: Refresh Token Store ───────────────────────────────────────────────

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tokenHash String   @unique @db.VarChar(255) @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isValid   Boolean  @default(true) @map("is_valid")
  ipAddress String?  @db.VarChar(45) @map("ip_address")
  userAgent String?  @db.VarChar(512) @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], name: "idx_refresh_tokens_user")
  @@map("refresh_tokens")
}

// ─── AI ──────────────────────────────────────────────────────────────────────
// Every AI table stores company_id, copied from the issue's product when the
// row is written. It duplicates the issue -> product -> company join on
// purpose: each AI row carries its own tenant, and per-company reporting
// doesn't need a three-table join.

// Durable queue of AI work. Rows are inserted in the same transaction as the
// issue or comment they belong to (transactional outbox), so a job exists if
// and only if its issue or comment was saved.
model AiJob {
  id            BigInt      @id @default(autoincrement())
  kind          AiJobKind
  status        AiJobStatus @default(queued)
  issueId       BigInt      @map("issue_id")
  commentId     BigInt?     @map("comment_id")
  companyId     BigInt      @map("company_id")
  attempts      Int         @default(0)
  maxAttempts   Int         @map("max_attempts")
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  lockedAt      DateTime?   @map("locked_at")
  lockedBy      String?     @db.VarChar(64) @map("locked_by")
  lastError     String?     @db.VarChar(500) @map("last_error")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  issue   Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment IssueComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt], name: "idx_ai_jobs_due")
  @@index([issueId], name: "idx_ai_jobs_issue")
  @@map("ai_jobs")
}

// One AI triage suggestion and what the reviewer did with it. Suggested and
// applied values are both kept, so acceptance can be reported per field.
model AiSuggestion {
  id                  BigInt             @id @default(autoincrement())
  issueId             BigInt             @map("issue_id")
  companyId           BigInt             @map("company_id")
  provider            String             @db.VarChar(32)
  model               String             @db.VarChar(64)
  promptVersion       String             @db.VarChar(32) @map("prompt_version")
  suggestedImpact     ImpactLevel        @map("suggested_impact")
  suggestedUrgency    UrgencyLevel       @map("suggested_urgency")
  suggestedCategory   IssueCategory      @map("suggested_category")
  suggestedTeam       EngineeringTeam    @map("suggested_team")
  impactReason        String             @db.VarChar(300) @map("impact_reason")
  urgencyReason       String             @db.VarChar(300) @map("urgency_reason")
  categoryReason      String             @db.VarChar(300) @map("category_reason")
  teamReason          String             @db.VarChar(300) @map("team_reason")
  manipulationAttempt Boolean            @map("manipulation_attempt")
  status              AiSuggestionStatus @default(pending)
  appliedImpact       ImpactLevel?       @map("applied_impact")
  appliedUrgency      UrgencyLevel?      @map("applied_urgency")
  appliedCategory     IssueCategory?     @map("applied_category")
  appliedTeam         EngineeringTeam?   @map("applied_team")
  reviewedBy          BigInt?            @map("reviewed_by")
  reviewedAt          DateTime?          @map("reviewed_at")
  createdAt           DateTime           @default(now()) @map("created_at")

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  reviewer User? @relation("AiSuggestionReviewer", fields: [reviewedBy], references: [id])

  @@index([issueId, createdAt], name: "idx_ai_suggestions_issue")
  @@index([companyId, status], name: "idx_ai_suggestions_company_status")
  @@map("ai_suggestions")
}

// Sentiment of one piece of client-written text: the issue itself
// (comment_id null) or one client comment. Internal signal for staff only;
// never used to compute priority.
model AiSentiment {
  id                  BigInt    @id @default(autoincrement())
  issueId             BigInt    @map("issue_id")
  commentId           BigInt?   @map("comment_id")
  companyId           BigInt    @map("company_id")
  sentiment           Sentiment
  frustrationLevel    Int       @db.SmallInt @map("frustration_level")
  escalationRisk      RiskLevel @map("escalation_risk")
  evidenceQuote       String    @db.VarChar(300) @map("evidence_quote")
  reason              String    @db.VarChar(300)
  manipulationAttempt Boolean   @map("manipulation_attempt")
  provider            String    @db.VarChar(32)
  model               String    @db.VarChar(64)
  promptVersion       String    @db.VarChar(32) @map("prompt_version")
  createdAt           DateTime  @default(now()) @map("created_at")

  issue   Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment IssueComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt], name: "idx_ai_sentiments_issue")
  @@index([companyId, createdAt], name: "idx_ai_sentiments_company")
  @@map("ai_sentiments")
}

// Append-only record of every call to the AI service: cost, latency and
// outcome. No foreign keys, so the audit trail survives issue deletion.
model AiCallLog {
  id             BigInt   @id @default(autoincrement())
  feature        String   @db.VarChar(32)
  status         String   @db.VarChar(40) // "ok" or an error code
  detail         String?  @db.VarChar(64)
  provider       String?  @db.VarChar(32)
  model          String?  @db.VarChar(64)
  promptVersion  String?  @db.VarChar(32) @map("prompt_version")
  latencyMs      Int?     @map("latency_ms")
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  thinkingTokens Int?     @map("thinking_tokens")
  companyId      BigInt?  @map("company_id")
  issueId        BigInt?  @map("issue_id")
  jobId          BigInt?  @map("job_id")
  requestId      String?  @db.VarChar(64) @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt], name: "idx_ai_call_logs_created")
  @@index([feature, status], name: "idx_ai_call_logs_feature_status")
  @@map("ai_call_logs")
}

// A suggested resolution for an issue, generated on request from the same
// company's past resolved issues, and whether the engineer found it helpful.
model AiResolutionSuggestion {
  id                  BigInt              @id @default(autoincrement())
  issueId             BigInt              @map("issue_id")
  companyId           BigInt              @map("company_id")
  provider            String              @db.VarChar(32)
  model               String              @db.VarChar(64)
  promptVersion       String              @db.VarChar(32) @map("prompt_version")
  hasRelevantHistory  Boolean             @map("has_relevant_history")
  summary             String              @db.VarChar(500)
  steps               String[]
  citedTickets        String[]            @map("cited_tickets")
  // Snapshot of the past issues retrieved: [{ issueId, ticketNumber, title, similarity }]
  sources             Json
  confidence          ConfidenceLevel
  manipulationAttempt Boolean             @map("manipulation_attempt")
  requestedBy         BigInt              @map("requested_by")
  feedback            ResolutionFeedback?
  feedbackBy          BigInt?             @map("feedback_by")
  feedbackAt          DateTime?           @map("feedback_at")
  createdAt           DateTime            @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt], name: "idx_ai_resolutions_issue")
  @@index([companyId, feedback], name: "idx_ai_resolutions_company_feedback")
  @@map("ai_resolution_suggestions")
}

// An AI summary of an issue's comment thread, generated on request by an admin.
// last_comment_id records the newest comment it covered: newer comments mean
// the summary is out of date.
model AiThreadSummary {
  id                  BigInt   @id @default(autoincrement())
  issueId             BigInt   @map("issue_id")
  companyId           BigInt   @map("company_id")
  provider            String   @db.VarChar(32)
  model               String   @db.VarChar(64)
  promptVersion       String   @db.VarChar(32) @map("prompt_version")
  summary             String   @db.VarChar(800)
  // [{ text, commentIds: string[] }]
  keyPoints           Json     @map("key_points")
  openQuestions       String[] @map("open_questions")
  manipulationAttempt Boolean  @map("manipulation_attempt")
  commentCount        Int      @map("comment_count")
  lastCommentId       BigInt?  @map("last_comment_id")
  requestedBy         BigInt   @map("requested_by")
  createdAt           DateTime @default(now()) @map("created_at")

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt], name: "idx_ai_summaries_issue")
  @@map("ai_thread_summaries")
}
